  Parameters:
  - Position: 1
    BoundsSafety:
      Kind: counted_by
      BoundedBy: "code_size"
- Name: cs_open
  SwiftSafety: unsafe
- Name: cs_close
  SwiftSafety: unsafe
- Name: cs_strerror
